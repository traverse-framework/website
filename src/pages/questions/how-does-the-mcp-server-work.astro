import QuestionLayout from '@layouts/QuestionLayout.astro';

const relatedLinks = [];
const _body = "<p>The Traverse MCP server is a separate binary, <code>traverse-mcp</code>, run as a stdio process. It sits between your AI agent or MCP-compatible client and your registered capabilities. Rather than the bare <code>tools/list</code>/<code>tools/call</code> pair some MCP servers expose, it speaks its own small line-delimited JSON command set purpose-built for discovering and running Traverse entrypoints.</p>\n\n      <h2>The core commands</h2>\n      <p><strong>list_entrypoints</strong> — returns the capabilities and workflows currently available as entrypoints. <strong>describe_entrypoint</strong> — returns one entrypoint's schema, drawn from its contract, so the agent knows what input it expects. The agent uses these to decide what to call and how.</p>\n      <p><strong>execute_entrypoint</strong> — takes an entrypoint id, version, and JSON input, runs it through the Traverse runtime, and returns the output (there's also <strong>validate_entrypoint</strong> to check a request without running it, and <strong>render_execution_report</strong> to get a human-readable report after the fact). If execution fails, the error goes back to the agent as a structured response. <strong>describe_server</strong>, <strong>list_content_groups</strong>, <strong>describe_content_group</strong>, and <strong>shutdown</strong> round out the command set.</p>\n\n      <h2>Starting the server</h2>\n      <pre><code>cargo run -p traverse-mcp -- stdio</code></pre>\n      <p>This starts the stdio server, in <code>local_trust</code> mode by default, against the current registry. To connect it to an MCP client, add it to your client's server config:</p>\n      <pre><code>{\n  \"mcpServers\": {\n    \"traverse\": {\n      \"command\": \"cargo\",\n      \"args\": [\"run\", \"-p\", \"traverse-mcp\", \"--\", \"stdio\"],\n      \"cwd\": \"/absolute/path/to/traverse\"\n    }\n  }\n}</code></pre>\n      <p>For stricter local launchers, setting <code>TRAVERSE_MCP_STDIO_BEARER_TOKEN</code> requires a matching bearer token on <code>execute_entrypoint</code> and <code>render_execution_report</code> calls; discovery and description commands stay open so a client can still bootstrap.</p>\n\n      <h2>Why this matters for AI agents</h2>\n      <p>Without contracts, an agent calling a tool is guessing. It sends inputs it thinks are valid and hopes the output matches what it expected. With Traverse, the agent gets the schema upfront via <code>describe_entrypoint</code>, and the caller's input is checked against that schema before <code>execute_entrypoint</code> runs it.</p>\n      <p>See <a href=\"/questions/how-do-ai-agents-discover-capabilities.html\">how AI agents discover capabilities</a> for more on the discovery flow.</p>";
const _jsonLd = "{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How does the Traverse MCP server work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Traverse MCP server (the traverse-mcp binary, run via cargo run -p traverse-mcp -- stdio) is a stdio server with its own command set: list_entrypoints and describe_entrypoint for discovery, and validate_entrypoint/execute_entrypoint/render_execution_report for running a capability or workflow and reporting on it, with input checked against its contract schema.\"}}]}";
---
<QuestionLayout
  title={"How does the Traverse MCP server work?"}
  description={"The traverse-mcp stdio server exposes your registered capabilities and workflows through its own discovery and execution commands so AI agents can find and call them. Learn how it works and how to set it up."}
