---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'How do I run the agent-blocked weekly demo?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'Clone traverse-framework/weekly-demos, open the 2026-09-18-agent-blocked folder, run npm install and node server.mjs, then open the local URL the server prints. Use node smoke.mjs for a Node-only check. The blog explains the deny story; the repo is what you run.',
    },
  }],
});

const relatedLinks = [
  { href: '/blog/agent-freestyle-blocked.html', label: 'Agent freestyle → blocked (blog)' },
  { href: '/what-is-real-today.html', label: 'What is real today' },
  { href: '/questions/what-does-discover-execute-trace-mean.html', label: 'discover → execute → trace' },
