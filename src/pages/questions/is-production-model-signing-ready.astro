---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'Is production model signing ready in Traverse?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'No, not as a finished production key program. digits-mlp-1.0.0 is signed with a test-only key so CI and demos can exercise Spec 138. v0.15.0 ships key generation, an opt-in TRAVERSE_MODEL_SIGNING_KEYS path, and a dispatch-only signing workflow (Decision 103). Custody, distribution, rotation, and revocation are still traverse#1567, which is open. Do not treat the test key as a production trust root.',
    },
  }],
});

const relatedLinks = [
  { href: '/questions/how-do-hosts-trust-signed-models.html', label: 'How do hosts trust signed models?' },
  { href: '/questions/which-hosts-run-signed-exact-ref-models.html', label: 'Which hosts run signed exact-ref models?' },
  { href: '/questions/what-is-exact-ref-model-execution.html', label: 'What is exact-ref model execution?' },
  { href: '/questions/what-is-digits-mlp.html', label: 'What is digits-mlp?' },
  { href: '/questions/how-do-i-verify-a-signed-capability-artifact.html', label: 'How do I verify a signed capability artifact?' },
  { href: '/questions/does-capability-publish-validate-model-attribution.html', label: 'Does publish validate model attribution?' },
