import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'How does Traverse check that a host can run a compatible capability?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'On Traverse v0.17.1, runtime.wasm starts a compatible capability only when the host platform string is in the capability platforms list. The init header carries execution_mode compatible, a non-empty platforms list, and host_platform. A miss fails with platform_not_supported, status -1, and emits no event. The same check lives in traverse_contracts::CompatibleLifecycle, which the Rust embedder uses too. The web embedder sends config.platform, or the string web when that field is omitted. v0.16.2 still returns -1 from the compatible exports without running this check.',
    },
  }],
});

const headerSnippet = `{
  "execution_mode": "compatible",
  "platforms": ["ios", "android"],
  "host_platform": "web"
}`;

