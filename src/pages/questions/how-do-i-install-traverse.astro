import QuestionLayout from '@layouts/QuestionLayout.astro';

const relatedLinks = [
  { href: '/questions/how-do-i-author-a-capability-in-plain-english.html', label: 'Author in plain English' },
  { href: '/questions/do-i-need-rust.html', label: 'Do I need to know Rust?' },
  { href: '/questions/can-i-use-traverse-with-python.html', label: 'Python (CLI, no SDK)' },
  { href: '/what-is-real-today.html', label: 'What is real today' },
  { href: '/docs/quickstart.html', label: 'Quickstart' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'How do I install Traverse?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'Usual paths need no full from-source install: author in plain English with the Claude skill traverse-capability-author, or consume via npm traverse-embedder-web, the Rust embedder, traverse-mcp, or Python via traverse-cli capability-package execute (no Python SDK). Contributors and manual authors build from source with Rust and the wasm32-wasip1 target; there are no binary releases yet.',
