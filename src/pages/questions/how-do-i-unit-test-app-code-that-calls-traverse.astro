---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'How do I unit-test app code that calls Traverse without running WASM?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'Swap the real embedder for the deterministic test double that ships in the same package. traverse-embedder-web and the Rust traverse-embedder crate (both 0.15.0) export EmbedderTestDouble, which implements the same embedder API: you script an output or an error per target id, and it emits the same event envelope with deterministic ids (sess-*, req-*, evt-*), rejects unknown targets with target_not_found, and rejects calls after shutdown with runtime_stopped. Swift, Kotlin, and .NET ship a smaller InMemoryTraverseEmbedder harness. A test double never loads WASM, so it tests your host code, not the capability.',
    },
  }],
});

const tsExample = `import { EmbedderTestDouble } from "traverse-embedder-web";

const embedder = new EmbedderTestDouble({ appId: "my-app", platform: "web" })
  .withTargetOutput("my-app.quote", { total_cents: 4200 })
  .withTargetError("my-app.charge", "execution_failed", "card declined");

const events = [];
embedder.subscribe((event) => events.push(event));

embedder.submit("my-app.quote", { items: 3 });
// events: capability_invoked, then capability_result with the scripted output

embedder.submit("my-app.nope", {});
// returns status "rejected", error.code "target_not_found"`;

const rustExample = `use serde_json::json;
use traverse_embedder::{EmbedderTestDouble, TraverseEmbedderApi};

let mut embedder = EmbedderTestDouble::new("local-default", "my-app", "1.0.0", "linux")
    .with_target_output("my-app.quote", json!({ "total_cents": 4200 }))
    .with_target_error("my-app.charge", "execution_failed", "card declined");

embedder.subscribe(Box::new(|event| println!("{event}")));
embedder.submit("my-app.quote", &json!({ "items": 3 }));
embedder.shutdown();`;

