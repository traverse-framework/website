---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'How do I cancel a running model.execute call in Traverse?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'On npm traverse-embedder-web@0.17.1, pass an AbortSignal to ExactModelBrowserHost.execute and call abort(). In a browser Worker the host terminates that Worker and the call fails with cancelled. On crates.io traverse-runtime 0.17.1, set ExactModelHostConnector.cancel to true while invoke is running. Wasmtime stops the guest at its next epoch check and the call fails with cancelled. Reset the flag to false before the next call. The connector does not clear it. On Node, and with createWorker: null, the guest runs to return and the host then reports cancelled. A guest that never returns stays running on that path. There is no traverse-runtime 0.17.0.',
    },
  }],
});

const browserSnippet = `import { ExactModelBrowserHost } from "traverse-embedder-web";

const controller = new AbortController();
const pending = host.execute({
  model_ref,
  input_ref,
  policy_ref: "policy-1",
  data_classification: "sensitive",
  input_schema_ref,
  input_schema_version: "1.0.0",
  max_output_bytes: 4096,
  allowed_classifications: ["sensitive"],
  signal: controller.signal,
});

controller.abort();`;

const nativeSnippet = `use std::sync::atomic::Ordering;

host.cancel.store(true, Ordering::SeqCst);`;

