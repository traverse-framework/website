---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'What happens when a Traverse capability runs out of fuel or memory?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'The call fails instead of running unbounded. Each native embedder sets host-owned limits on every bridge call (artifact size, linear memory, fuel or instruction budget, and a deadline) and stops the call when one is exceeded. On the Swift host that failure is status -4 with code bridge_timeout for exhausted fuel or bridge_resource_limit for memory and size bounds; other guest traps are status -5, bridge_trap. The .NET host defaults to a 32 MiB memory ceiling, 10,000,000 fuel, and a 30-second deadline per call. Limits are set by the host app, not by the capability.',
    },
  }],
});

const relatedLinks = [
  { href: '/questions/what-is-the-wasm-sandbox.html', label: 'What is the WASM sandbox?' },
  { href: '/questions/what-happens-when-a-capability-fails.html', label: 'What happens when a capability fails?' },
  { href: '/questions/is-there-a-performance-cost-to-running-the-same-binary-on-every-os.html', label: 'Is there a performance cost to running the same binary on every OS?' },
