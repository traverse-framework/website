  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'What errors does a web compatible capability return?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'On traverse main since #1824 (merged November 6, 2026, Decision 128), the web host passes runtime.wasm compatible-lifecycle codes through: compatible_instance_active, compatible_instance_not_active, input_not_canonicalizable, invalid_input, and platform_not_supported. instance_not_found and instance_not_running are gone, and only one instance runs per capability at a time. This is breaking for web callers that matched the old codes or started a second instance. Published traverse-embedder-web 0.16.2 still uses the old TypeScript lifecycle and codes. Not in a tagged release yet.',
    },
  }],
