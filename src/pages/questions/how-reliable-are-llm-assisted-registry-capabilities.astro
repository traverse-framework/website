---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'How reliable are LLM-assisted capabilities in the Traverse registry?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'Not reliable enough yet to relax review. The registry measured it against a bar fixed before any data was collected (registry#660, docs/llm-authoring-evaluation.md). Results (registry#661, merged November 10, 2026): in the promotion bucket of low-risk, deterministic llm-assisted versions, 7 of 25 escaped (28%) against a bar of 10% or less. Six of the seven were contract values the registry accepted but traverse-contracts rejected, a class the new publish parse gate now catches. One was a behavior defect in text.truncate@1.0.0 on wasm32. Decision-log entry 139: no promotion, the low-risk tier stays experimental, and a controlled run (registry#659) is the next step.',
    },
  }],
});

const relatedLinks = [
  { href: '/questions/does-the-registry-check-that-published-contracts-parse.html', label: 'Does the registry check that published contracts actually parse?' },
  { href: '/questions/what-does-human-review-mean-for-a-capability-pr.html', label: 'What does human review mean for a capability PR?' },
  { href: '/questions/how-do-i-review-a-capability-pr-as-a-maintainer.html', label: 'How do I review a capability PR as a maintainer?' },
  { href: '/questions/how-do-i-publish-a-capability-to-the-registry.html', label: 'How do I publish a capability to the registry?' },
