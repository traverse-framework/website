const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'Is the agent MCP exact-ref demo the same as traverse-mcp?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'No. The October 9 weekly demo (agent-mcp-exact-ref) uses an in-process MCP-shaped JSON-RPC façade over ExactModelBrowserHost under Node. It is not the checksum-pinned Mode A traverse-mcp binary. Mode A traverse-mcp is the published stdio MCP server for discover, inspect, and execute of registry capabilities. Checksum-pinned Mode A binaries are #1653: the packaging workflow merged on main and the first traverse-mcp-v* artifact release comes with the next product tag. None is published yet.',
    },
  }],
});

const relatedLinks = [
  { href: '/blog/agent-mcp-exact-ref.html', label: 'Agent speaks MCP. Exact pin kills the freestyle.' },
