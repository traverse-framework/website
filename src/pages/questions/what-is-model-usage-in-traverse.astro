---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'What is model_usage in Traverse, and why does my app fail with usage_undeclared?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'model_usage is the app’s declaration of how it uses pinned models: commercial or non_commercial. Since Traverse v0.15.0 (a breaking change, Spec 138 0.8.0, Decision 107) an app with exact_model_dependencies must declare it, or registration and execution fail closed with usage_undeclared. A commercial usage rejects packages whose rights say commercial_use: prohibited, with rights_policy_denied. Every result carries model_evidence. Caveat: published traverse-embedder-web@0.15.0 does not validate the value yet (traverse#1685), and traverse-cli-rs 0.15.0 model verify has no usage flag (traverse#1686, fixed on main after the release).',
    },
  }],
});

const relatedLinks = [
  { href: '/blog/signed-models-on-every-host.html', label: 'Signed models on every host (v0.15.0)' },
  { href: '/questions/which-hosts-run-signed-exact-ref-models.html', label: 'Which hosts run signed exact-ref models?' },
  { href: '/questions/what-happens-when-a-host-marks-a-model-package-revoked.html', label: 'What happens when a model package is revoked?' },
