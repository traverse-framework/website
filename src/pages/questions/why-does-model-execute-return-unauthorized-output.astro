---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'Why does model.execute return unauthorized_output when my host passes model evidence through?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'The Spec 104 host-private output filter in the native executor rejects any connector output string that starts with / or contains ://. The full ModelRightsRecord that Spec 138 hosts return carries source_url values (https:// URLs), so forwarding it verbatim from a connector bridge into the catalog model.execute@1.0.0 guest fails with unauthorized_output (-4). As of 2026-10-29 the registry publishes model.execute@1.1.0 (registry#641, closed via registry#645), which defines a normative flat model_evidence shape: license_id, commercial_use, status, effective_usage, and an optional derivation without URLs. Hosts and bridges should emit exactly that shape. Forwarding the full nested ModelRightsRecord is non-conformant. A shipped host binding that emits it on every host is still open in traverse#1719.',
    },
  }],
});

const relatedLinks = [
  { href: '/questions/what-is-the-model-execute-catalog-capability.html', label: 'What is the model.execute catalog capability?' },
  { href: '/questions/why-does-bundleembedder-fail-with-cannot-find-definition-for-import-connector-invoke.html', label: 'Why does BundleEmbedder fail on the connector_invoke import?' },
  { href: '/questions/what-is-model-usage-in-traverse.html', label: 'What is model_usage?' },
  { href: '/questions/how-do-hosts-trust-signed-models.html', label: 'How do hosts trust signed models?' },
  { href: '/blog/catalog-model-execute.html', label: 'Weekly demo: catalog model.execute' },
