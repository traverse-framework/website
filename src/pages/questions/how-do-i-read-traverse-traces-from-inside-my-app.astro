const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'How do I read Traverse execution traces from inside my app?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'Call the Embedded Trace API on the embedder you already have. In traverse-embedder-web and the Rust traverse-embedder crate (0.15.0), traceList(version, pageSize, cursor) pages through the current session\'s traces, newest first, and traceGet(version, traceId) opens one. Each record is a safe public projection: target id and version, outcome, execution phases, placement, and a stable failure code. It never includes raw inputs, outputs, caller identity, or private hashes. History is process-local, capped at the last 100 executions, and cleared on shutdown. No HTTP sidecar is involved. The Swift, Kotlin, and .NET packages do not expose this API yet.',
    },
  }],
});

const traceExample = `const page = embedder.traceList("1.0.0", 10);
// { summaries: [...], nextCursor: null, retentionLimit: 100 }

const detail = embedder.traceGet("1.0.0", page.summaries[0].traceId);`;

const traceOutput = `{
  "summary": {
    "traceId": "embedded-trace-00000001-00000001",
    "executionId": "workflow-req-00000001",
    "targetId": "traverse-starter.process",
    "completedAt": "1970-01-01T00:00:01Z",
    "completionSequence": 1,
    "outcome": "completed"
  },
  "phases": [{ "code": "workflow_completed" }],
  "selectedTarget": { "targetId": "traverse-starter.process", "targetVersion": "1.0.0" },
  "placement": { "target": "browser" },
  "failureCode": null,
  "stateMachineValid": null
}`;

