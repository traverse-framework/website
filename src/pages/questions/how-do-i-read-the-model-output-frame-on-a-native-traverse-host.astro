---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'How do I read the model output frame on a native Traverse host?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'On crates.io traverse-runtime 0.17.1, keep the mediated connector in an Arc and activate it with ExactModelMediatedConnector::activated(). After model.execute, read the bytes behind output_ref with with_host_mut and host.io.read_model_output. activate_exact_model_runtime still takes the host by value, so the caller cannot read the frame through that function. This is changelog entry #1785, pull request #1809. On npm traverse-embedder-web@0.17.1 the host object stays with the caller, and host.io.readModelOutput reads result.output_ref. Swift, Android, and .NET do not ship this mediated activation API in v0.17.1.',
    },
  }],
});

const nativeSnippet = `use std::sync::Arc;
use traverse_runtime::ExactModelMediatedConnector;

let connector = Arc::new(ExactModelMediatedConnector::new(host));
let context = MediatedConnectorContext {
    declared_requirements: /* from the capability contract */,
    activated_connectors: vec![connector.activated()],
};
let output = executor
    .run_bytes_with_mediated_connectors(&wasm, &input, "cap", context)?;
let output_ref = output.value["output_ref"].as_str().ok_or("no output_ref")?;
let frame = connector
    .with_host_mut(|host| host.io.read_model_output(output_ref, max_bytes))??;`;

const webSnippet = `const bytes = host.io.readModelOutput(result.output_ref, maxBytes);`;

