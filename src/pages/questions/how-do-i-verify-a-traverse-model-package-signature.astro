---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'How do I verify a Traverse model package signature before I run it?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'Run traverse-cli model verify on the package directory with the Ed25519 public key you trust, before any host registers the package. The command checks the detached model.sig.json signature, the key, the manifest, the rights, and the WASM digest. It exits non-zero on failure. In Traverse v0.17.1, TRAVERSE_MODEL_SIGNING_KEYS is empty and keys/model-signing has no public key file. digits-mlp-1.0.0 in that tag uses the test-only key. Pass only a key you intend the host to trust.',
    },
  }],
});

const installSnippet = `cargo +1.95.0 install traverse-cli-rs \\
  --version =0.17.1 --locked`;

const verifySnippet = `traverse-cli model verify out/digits \\
  --trusted-key <public-key-hex> \\
  --model-usage commercial \\
  --json`;

const relatedLinks = [
  { href: '/questions/how-does-the-same-signed-model-package-run-on-every-traverse-host.html', label: 'How does the same signed model package run on every Traverse host?' },
  { href: '/questions/is-production-model-signing-ready.html', label: 'Is production model signing ready?' },
  { href: '/questions/how-do-hosts-trust-signed-models.html', label: 'How do hosts trust signed models?' },
