---
import QuestionLayout from '@layouts/QuestionLayout.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'Can I build a mobile app with Traverse?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'Partially, and it now depends on the platform. iOS has a production runtime bridge — a wasmi-based Swift host certified under ADR-0014 and ADR-0015 — distributed as an XCFramework. Android has a working runtime bridge (Chicory-based) with no public release yet. Only Android and .NET/WinUI remain unshipped, unreleased work today.',
    },
  }],
});

const relatedLinks = [
  { href: '/questions/does-traverse-support-windows-macos-and-linux.html', label: 'Does Traverse support Windows, macOS, and Linux?' },
  { href: '/questions/what-framework-runs-business-logic-on-any-os.html', label: 'What framework lets me write business logic once and run it on any OS?' },
