const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'What is governed composition in Traverse?',
    acceptedAnswer: {
      '@type': 'Answer',
      text: 'Governed composition is how Traverse turns a proposed multi-capability workflow into an authorized, contract-checked execution with a durable trace. An agent or planner may propose the graph; the runtime decides what is allowed to run, validates each node, and records what happened. A proposal is not ambient authority.',
    },
