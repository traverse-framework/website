---
import SubpageLayout from '@layouts/SubpageLayout.astro';
import DocsSidebar from '@components/DocsSidebar.astro';
---

<SubpageLayout title="Quickstart — Traverse Framework" description="Build Traverse and inspect a governed capability bundle with the current v0.9.1 quickstart." canonical="https://traverse-framework.com/docs/quickstart.html" crumbs={[{ label: 'Home', href: '/' }, { label: 'Docs', href: '/docs.html' }]}>
  <div class="docs-layout"><DocsSidebar active="/docs/quickstart.html" /><main class="docs-content">
    <div class="section-label">Getting started</div><h1 class="t-h1">Quickstart</h1>
    <p class="t-body t-muted">Build the current runtime and inspect a governed bundle. This path works with Traverse v0.9.1 and Rust 1.94 or later.</p>
    <pre><code>git clone https://github.com/traverse-framework/traverse.git
cd traverse
cargo build
cargo run -p traverse-cli-rs -- bundle inspect examples/expedition/registry-bundle/manifest.json</code></pre>
    <p class="t-body t-muted">The inspection output identifies the expedition bundle and its registered capabilities, events, and workflow. From there, follow the maintained repository quickstart for browser, native embedder, and app-consumer paths.</p>
    <div class="actions"><a class="btn btn-primary" href="https://github.com/traverse-framework/traverse/blob/main/quickstart.md">Open the full quickstart →</a><a class="btn btn-ghost" href="https://github.com/traverse-framework/traverse/blob/main/docs/getting-started.md">Read getting started</a></div>
    <section class="doc-section"><h2 class="t-h2">What to try next</h2><ul><li><a href="/docs/cli-reference.html">Explore the current CLI workflow</a></li><li><a href="https://github.com/traverse-framework/traverse/blob/main/docs/capability-publish.md">Publish a governed capability</a></li><li><a href="https://github.com/traverse-framework/traverse/blob/main/docs/app-consumable-entry-path.md">Integrate Traverse into an app</a></li></ul></section>
  </main></div>
  <style is:global>.docs-content{max-width:820px}.docs-content h1{margin:.4rem 0 .75rem}pre{overflow-x:auto;margin:1.75rem 0;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);padding:1rem}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin:1.5rem 0 2.5rem}.doc-section{border-top:1px solid var(--border);padding-top:2rem}.doc-section li{margin:.55rem 0}</style>
</SubpageLayout>
