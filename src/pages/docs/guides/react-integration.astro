---
import SubpageLayout from '@layouts/SubpageLayout.astro';

const _body = "<div class=\"docs-layout\">\n  <aside class=\"docs-sidebar\">\n    <div class=\"docs-sidebar-section\">\n      <div class=\"docs-sidebar-title\">Getting Started</div>\n      <div class=\"docs-sidebar-links\">\n        <a href=\"/docs/quickstart.html\">Quickstart</a>\n      </div>\n    </div>\n    <div class=\"docs-sidebar-section\">\n      <div class=\"docs-sidebar-title\">Core Concepts</div>\n      <div class=\"docs-sidebar-links\">\n        <a href=\"/docs/concepts.html\">Contracts</a>\n        <a href=\"/docs/architecture.html\">Architecture</a>\n      </div>\n    </div>\n    <div class=\"docs-sidebar-section\">\n      <div class=\"docs-sidebar-title\">Guides</div>\n      <div class=\"docs-sidebar-links\">\n        <a href=\"/docs/guides.html\">All Guides</a>\n        <a href=\"/docs/guides/mcp-setup.html\">MCP Setup</a>\n        <a href=\"/docs/guides/react-integration.html\" class=\"active\">React Integration</a>\n        <a href=\"/docs/quickstart.html\">Author a Capability</a>\n        <a href=\"/docs/concepts.html#workflows\">Build a Workflow</a>\n      </div>\n    </div>\n    <div class=\"docs-sidebar-section\">\n      <div class=\"docs-sidebar-title\">Reference</div>\n      <div class=\"docs-sidebar-links\">\n        <a href=\"/docs/cli-reference.html\">CLI Reference</a>\n        <a href=\"/docs/troubleshooting.html\">Troubleshooting</a>\n        <a href=\"/examples.html\">Examples</a>\n        <a href=\"/changelog.html\">Changelog</a>\n      </div>\n    </div>\n  </aside>\n\n  <main class=\"docs-content\">\n    <div style=\"margin-bottom:2rem\">\n      <div class=\"section-label\" style=\"margin-bottom:0.75rem\">Guide</div>\n      <h1 class=\"t-h1\" style=\"margin-bottom:0.75rem\">React Integration</h1>\n      <p class=\"t-body t-muted\">Add Traverse capabilities to your React app. You do not need to know Rust. The <code>traverse-cli serve</code> HTTP/JSON API handles all capability execution. Your app only needs to make HTTP requests.</p>\n      <div style=\"display:flex;gap:0.5rem;margin-top:1rem;flex-wrap:wrap\">\n        <span class=\"badge badge-success badge-dot\">v0.10.1</span>\n        <span class=\"badge\">~20 minutes</span>\n        <span class=\"badge\">Node.js 18+</span>\n        <span class=\"badge\">Rust 1.94+</span>\n      </div>\n    </div>\n\n    <!-- Step 1 -->\n    <div class=\"doc-step\">\n      <div class=\"step-marker\">\n        <div class=\"step-circle\">01</div>\n        <span class=\"step-label\">Start the adapter</span>\n      </div>\n      <h2 class=\"t-h2\" style=\"margin-bottom:0.75rem\">Start the HTTP/JSON API</h2>\n      <p class=\"t-body t-muted\" style=\"margin-bottom:1.25rem\">\n        <code>traverse-cli serve</code> is a local development/CI HTTP server (spec 033-http-json-api). It takes requests from your React app, runs the WASM capability, and returns a structured response. Start it first, before your React dev server. It is not the production app topology — production apps embed Traverse through the public embedder packages.\n      </p>\n      <div class=\"terminal\">\n        <div class=\"terminal-header\"><div class=\"code-dots\"><span></span><span></span><span></span></div><span class=\"terminal-title\">Terminal 1 — traverse-cli serve</span></div>\n        <div class=\"terminal-body\">\n          <div class=\"terminal-line\"><span class=\"terminal-prompt\">$</span><span class=\"terminal-cmd\"> cargo run -p traverse-cli-rs -- serve \\</span></div>\n          <div class=\"terminal-line\"><span class=\"terminal-cmd\">     --registry-state /srv/traverse/verified-registry.json</span></div>\n          <div class=\"terminal-line\"><span class=\"terminal-out\"></span></div>\n          <div class=\"terminal-line\"><span class=\"terminal-out\">traverse-cli serve: HTTP/JSON API listening on http://127.0.0.1:8787 (spec 033-http-json-api)</span></div>\n        </div>\n      </div>\n      <p class=\"t-body t-muted\" style=\"margin-top:1rem\">Leave this running. Open a second terminal for the next step. See the <a href=\"/docs/cli-reference.html\">CLI reference</a> for every <code>serve</code> flag.</p>\n    </div>\n\n    <!-- Step 2 -->\n    <div class=\"doc-step\">\n      <div class=\"step-marker\">\n        <div class=\"step-circle\">02</div>\n        <span class=\"step-label\">Working example</span>\n      </div>\n      <h2 class=\"t-h2\" style=\"margin-bottom:0.75rem\">Start your React dev server</h2>\n      <p class=\"t-body t-muted\" style=\"margin-bottom:1.25rem\">\n        With <code>traverse-cli serve</code> already running, start your own React dev server (Vite, CRA, Next — any of them work, since the API is a plain HTTP endpoint) in a second terminal.\n      </p>\n      <div class=\"terminal\">\n        <div class=\"terminal-header\"><div class=\"code-dots\"><span></span><span></span><span></span></div><span class=\"terminal-title\">Terminal 2 — React dev server</span></div>\n        <div class=\"terminal-body\">\n          <div class=\"terminal-line\"><span class=\"terminal-prompt\">$</span><span class=\"terminal-cmd\"> npm run dev</span></div>\n          <div class=\"terminal-line\"><span class=\"terminal-out\">Local: http://localhost:5173</span></div>\n        </div>\n      </div>\n      <p class=\"t-body t-muted\" style=\"margin-top:1rem\">Open your app in the browser and fetch against the API from step 1 (see step 4 below).</p>\n      <div class=\"success-box\">\n        <strong>Both processes must be running.</strong> <code>traverse-cli serve</code> on port 8787 and your React dev server on its own port. Requests fail if <code>serve</code> is not up.\n      </div>\n    </div>\n\n    <!-- Step 3 -->\n    <div class=\"doc-step\">\n      <div class=\"step-marker\">\n        <div class=\"step-circle\">03</div>\n        <span class=\"step-label\">How it works</span>\n      </div>\n      <h2 class=\"t-h2\" style=\"margin-bottom:0.75rem\">How the connection works</h2>\n      <p class=\"t-body t-muted\" style=\"margin-bottom:1.25rem\">\n        Your React app never touches Rust or WASM directly. It talks to the <code>traverse-cli serve</code> HTTP/JSON API over plain HTTP. The API owns everything else.\n      </p>\n      <div class=\"arch-diagram\">\n        <div><span class=\"arch-box\">React app</span> <span class=\"arch-arrow\">→ POST /v1/capabilities/execute →</span> <span class=\"arch-box accent\">serve :8787</span></div>\n        <div style=\"margin-left:2.5rem;color:var(--fg-muted);font-size:0.75rem\">JSON body: a RuntimeRequest</div>\n        <div style=\"margin-left:4rem\"><span class=\"arch-arrow\">↓</span></div>\n        <div style=\"margin-left:4rem\"><span class=\"arch-box\">Traverse runtime</span></div>\n        <div style=\"margin-left:4rem\"><span class=\"arch-arrow\">↓</span></div>\n        <div style=\"margin-left:4rem\"><span class=\"arch-box\">WASM capability</span></div>\n        <div style=\"margin-left:4rem\"><span class=\"arch-arrow\">↓</span></div>\n        <div><span class=\"arch-box accent\">serve :8787</span> <span class=\"arch-arrow\">→ JSON response →</span> <span class=\"arch-box\">React app</span></div>\n        <div style=\"margin-left:2.5rem;color:var(--fg-muted);font-size:0.75rem\">trace + result fields</div>\n      </div>\n      <p class=\"t-body t-muted\">Relevant endpoints: <code>GET /healthz</code> for liveness checks, <code>GET /v1/capabilities</code> to list what is registered, and <code>POST /v1/capabilities/execute</code> for running capabilities.</p>\n    </div>\n\n    <!-- Step 4 -->\n    <div class=\"doc-step\">\n      <div class=\"step-marker\">\n        <div class=\"step-circle\">04</div>\n        <span class=\"step-label\">Submit a request</span>\n      </div>\n      <h2 class=\"t-h2\" style=\"margin-bottom:0.75rem\">Submit a governed request from React</h2>\n      <p class=\"t-body t-muted\" style=\"margin-bottom:1.25rem\">\n        Use any HTTP client. The body is a <code>RuntimeRequest</code>: it names the exact <code>capability_id</code> to run — there is no free-text goal matching — plus the business <code>input</code> payload and a <code>context</code> object.\n      </p>\n      <div class=\"code-block\">\n        <div class=\"code-header\"><div class=\"code-dots\"><span></span><span></span><span></span></div><span class=\"code-filename\">useTraverse.js</span></div>\n        <div class=\"code-body\">\n<span class=\"tok-key\">const</span> <span class=\"tok-fn\">executeCapability</span> = <span class=\"tok-key\">async</span> (capabilityId, input) =&gt; {\n  <span class=\"tok-key\">const</span> response = <span class=\"tok-key\">await</span> fetch(<span class=\"tok-str\">'http://127.0.0.1:8787/v1/capabilities/execute'</span>, {\n    method: <span class=\"tok-str\">'POST'</span>,\n    headers: { <span class=\"tok-str\">'Content-Type'</span>: <span class=\"tok-str\">'application/json'</span> },\n    body: JSON.stringify({\n      kind: <span class=\"tok-str\">'runtime_request'</span>,\n      schema_version: <span class=\"tok-str\">'1.0.0'</span>,\n      request_id: crypto.randomUUID(),\n      intent: { capability_id: capabilityId },\n      input: input,\n      lookup: { scope: <span class=\"tok-str\">'prefer_private'</span>, allow_ambiguity: <span class=\"tok-key\">false</span> },\n      context: { requested_target: <span class=\"tok-str\">'local'</span>, caller: <span class=\"tok-str\">'my-react-app'</span> },\n      governing_spec: <span class=\"tok-str\">'006-runtime-request-execution'</span>\n    })\n  });\n\n  <span class=\"tok-key\">if</span> (!response.ok) {\n    <span class=\"tok-key\">throw new</span> Error(<span class=\"tok-str\">`API error: ${response.status}`</span>);\n  }\n\n  <span class=\"tok-key\">return</span> response.json();\n};\n        </div>\n      </div>\n      <p class=\"t-body t-muted\" style=\"margin-top:1rem\">\n        <code>intent.capability_id</code> must exactly name a registered capability (an <code>intent_key</code> semantic alias is also accepted). The <code>context.caller</code> field identifies your app in trace records.\n      </p>\n      <div class=\"info-box\">\n        <strong>context.requested_target</strong> tells the runtime which placement to prefer. Use <code>local</code> for server-side execution. The Web embedder SDK also executes bundles directly in the browser; see <a href=\"/platforms.html\" style=\"color:var(--accent)\">Platforms</a> for which targets have a real, shipped executor today.\n      </div>\n    </div>\n\n    <!-- Step 5 -->\n    <div class=\"doc-step\">\n      <div class=\"step-marker\">\n        <div class=\"step-circle\">05</div>\n        <span class=\"step-label\">Read the response</span>\n      </div>\n      <h2 class=\"t-h2\" style=\"margin-bottom:0.75rem\">Reading the response</h2>\n      <p class=\"t-body t-muted\" style=\"margin-bottom:1.25rem\">\n        A successful response is a JSON object with <code>result</code>, <code>trace</code>, and <code>state_events</code>. Check <code>result.status</code> first, then read <code>result.output</code>.\n      </p>\n      <div class=\"code-block\">\n        <div class=\"code-header\"><div class=\"code-dots\"><span></span><span></span><span></span></div><span class=\"code-filename\">example response (abridged)</span></div>\n        <div class=\"code-body\">\n<span class=\"tok-section\">{</span>\n  <span class=\"tok-key\">\"result\"</span>: <span class=\"tok-section\">{</span>\n    <span class=\"tok-key\">\"execution_id\"</span>: <span class=\"tok-str\">\"exec_7f3a1b\"</span>,\n    <span class=\"tok-key\">\"request_id\"</span>: <span class=\"tok-str\">\"...\"</span>,\n    <span class=\"tok-key\">\"status\"</span>: <span class=\"tok-str\">\"completed\"</span>,\n    <span class=\"tok-key\">\"trace_ref\"</span>: <span class=\"tok-str\">\"trc_7f3a1b\"</span>,\n    <span class=\"tok-key\">\"output\"</span>: <span class=\"tok-section\">{ <span class=\"tok-comment\">/* shape defined by the capability's outputs schema */</span> }</span>\n  <span class=\"tok-section\">}</span>,\n  <span class=\"tok-key\">\"trace\"</span>: <span class=\"tok-section\">{ <span class=\"tok-comment\">/* full runtime trace artifact */</span> }</span>,\n  <span class=\"tok-key\">\"state_events\"</span>: <span class=\"tok-section\">[]</span>\n<span class=\"tok-section\">}</span>\n        </div>\n      </div>\n      <div style=\"background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:1.25rem;margin-top:1.25rem\">\n        <div class=\"response-field\">\n          <div class=\"rf-key\">result.status</div>\n          <div class=\"rf-desc\"><code>completed</code> or <code>error</code>. Always check this before reading output. On error, <code>result.error</code> is present.</div>\n        </div>\n        <div class=\"response-field\">\n          <div class=\"rf-key\">result.trace_ref</div>\n          <div class=\"rf-desc\">Reference into the trace artifact. Store it if you want to correlate frontend events with backend traces.</div>\n        </div>\n        <div class=\"response-field\">\n          <div class=\"rf-key\">result.execution_id</div>\n          <div class=\"rf-desc\">Unique execution ID for this request. Useful for logging and debugging.</div>\n        </div>\n        <div class=\"response-field\">\n          <div class=\"rf-key\">result.output</div>\n          <div class=\"rf-desc\">The capability's output payload. Shape is defined by the contract's outputs schema. Will vary by capability.</div>\n        </div>\n        <div class=\"response-field\">\n          <div class=\"rf-key\">trace</div>\n          <div class=\"rf-desc\">The full runtime trace artifact — discovery, constraint evaluation, and state transitions.</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Step 6 -->\n    <div class=\"doc-step\">\n      <div class=\"step-marker\">\n        <div class=\"step-circle\">06</div>\n        <span class=\"step-label\">Streaming</span>\n      </div>\n      <h2 class=\"t-h2\" style=\"margin-bottom:0.75rem\">Handling streaming updates</h2>\n      <p class=\"t-body t-muted\" style=\"margin-bottom:1.25rem\">\n        Live updates are scoped to a registered <a href=\"/docs/app-manifest.html\">app</a> and its <a href=\"/docs/state-machine.html\">state machine</a> sessions, not to a single ad-hoc capability call. The transport is a WebSocket upgrade at <code>/v1/workspaces/&lt;workspace_id&gt;/apps/&lt;app_id&gt;/events</code> — the earlier server-sent-events transport for this path has been retired in favor of WebSocket (spec 097-websocket-grpc-event-transport / ADR-0034); a plain GET to that path now returns <code>426 Upgrade Required</code> with error code <code>sse_retired</code>.\n      </p>\n      <div class=\"code-block\">\n        <div class=\"code-header\"><div class=\"code-dots\"><span></span><span></span><span></span></div><span class=\"code-filename\">subscribe over WebSocket</span></div>\n        <div class=\"code-body\">\n<span class=\"tok-key\">const</span> subscribeToAppEvents = (workspaceId, appId) =&gt; {\n  <span class=\"tok-key\">const</span> socket = <span class=\"tok-key\">new</span> WebSocket(\n    <span class=\"tok-str\">`ws://127.0.0.1:8787/v1/workspaces/${workspaceId}/apps/${appId}/events`</span>\n  );\n\n  socket.addEventListener(<span class=\"tok-str\">'message'</span>, (event) =&gt; {\n    <span class=\"tok-key\">const</span> data = JSON.parse(event.data);\n    console.log(<span class=\"tok-str\">'App event:'</span>, data);\n  });\n\n  <span class=\"tok-key\">return</span> () =&gt; socket.close(); <span class=\"tok-comment\">// cleanup</span>\n};\n        </div>\n      </div>\n      <p class=\"t-body t-muted\" style=\"margin-top:1rem\">\n        This channel replays and streams state-machine session events for the named app, so it fits a governed multi-step flow better than a single stateless capability call. For a single <code>POST /v1/capabilities/execute</code> call, the synchronous response already carries the full trace.\n      </p>\n    </div>\n\n    <!-- Step 7 -->\n    <div class=\"doc-step\">\n      <div class=\"step-marker\">\n        <div class=\"step-circle\">07</div>\n        <span class=\"step-label\">Display trace data</span>\n      </div>\n      <h2 class=\"t-h2\" style=\"margin-bottom:0.75rem\">Displaying trace data in your UI</h2>\n      <p class=\"t-body t-muted\" style=\"margin-bottom:1.25rem\">\n        The trace data in the response gives you everything you need to build a developer-facing execution panel. Here is a minimal React component that renders the key fields.\n      </p>\n      <div class=\"code-block\">\n        <div class=\"code-header\"><div class=\"code-dots\"><span></span><span></span><span></span></div><span class=\"code-filename\">TracePanel.jsx</span></div>\n        <div class=\"code-body\">\n<span class=\"tok-key\">function</span> <span class=\"tok-fn\">TracePanel</span>({ result, trace }) {\n  <span class=\"tok-key\">if</span> (!result) <span class=\"tok-key\">return</span> <span class=\"tok-key\">null</span>;\n\n  <span class=\"tok-key\">return</span> (\n    &lt;div className=<span class=\"tok-str\">\"trace-panel\"</span>&gt;\n      &lt;div className=<span class=\"tok-str\">\"trace-row\"</span>&gt;\n        &lt;span&gt;Status&lt;/span&gt;\n        &lt;span className={result.status === <span class=\"tok-str\">'completed'</span> ? <span class=\"tok-str\">'success'</span> : <span class=\"tok-str\">'error'</span>}&gt;\n          {result.status}\n        &lt;/span&gt;\n      &lt;/div&gt;\n      &lt;div className=<span class=\"tok-str\">\"trace-row\"</span>&gt;\n        &lt;span&gt;Execution ID&lt;/span&gt;\n        &lt;code&gt;{result.execution_id}&lt;/code&gt;\n      &lt;/div&gt;\n      &lt;div className=<span class=\"tok-str\">\"trace-row\"</span>&gt;\n        &lt;span&gt;Trace ref&lt;/span&gt;\n        &lt;code&gt;{result.trace_ref}&lt;/code&gt;\n      &lt;/div&gt;\n      {trace?.emitted_events?.length &gt; 0 &amp;&amp; (\n        &lt;div className=<span class=\"tok-str\">\"trace-row\"</span>&gt;\n          &lt;span&gt;Events&lt;/span&gt;\n          &lt;span&gt;{trace.emitted_events.map(e =&gt; e.id).join(<span class=\"tok-str\">', '</span>)}&lt;/span&gt;\n        &lt;/div&gt;\n      )}\n    &lt;/div&gt;\n  );\n}\n        </div>\n      </div>\n      <p class=\"t-body t-muted\" style=\"margin-top:1rem\">\n        Show the trace panel in a collapsible section alongside your main output. It gives developers immediate visibility into what ran, which version, and how long it took.\n      </p>\n\n      <div class=\"success-box\" style=\"margin-top:1.5rem\">\n        <strong>No Rust required on your side.</strong> Your React app is a plain HTTP client. <code>traverse-cli serve</code> handles registry lookups, constraint evaluation, WASM execution, and event emission. You only deal with JSON.\n      </div>\n    </div>\n\n    <!-- Next steps -->\n    <div style=\"padding-top:2rem\">\n      <h2 class=\"t-h2\" style=\"margin-bottom:1rem\">Next steps</h2>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1rem\">\n        <a href=\"/docs/troubleshooting.html#react-blank\" class=\"card card-accent-hover\" style=\"text-decoration:none;padding:1.25rem\">\n          <div class=\"t-label t-accent\" style=\"margin-bottom:0.5rem\">Troubleshooting</div>\n          <div class=\"t-body-sm t-muted\">Blank page or connection errors? Common fixes for the HTTP/JSON API setup.</div>\n        </a>\n        <a href=\"/docs/architecture.html\" class=\"card card-accent-hover\" style=\"text-decoration:none;padding:1.25rem\">\n          <div class=\"t-label t-accent\" style=\"margin-bottom:0.5rem\">Architecture</div>\n          <div class=\"t-body-sm t-muted\">Understand what traverse-cli serve does internally and what the trace contains.</div>\n        </a>\n        <a href=\"/docs/guides/mcp-setup.html\" class=\"card card-accent-hover\" style=\"text-decoration:none;padding:1.25rem\">\n          <div class=\"t-label t-accent\" style=\"margin-bottom:0.5rem\">MCP Setup</div>\n          <div class=\"t-body-sm t-muted\">Expose the same capabilities to AI agents over the MCP protocol.</div>\n        </a>\n      </div>\n    </div>\n  </main>\n</div>\n\n<script src=\"/assets/js/nav.js\"></script>";
---
<SubpageLayout
  title={"React Integration: Traverse Docs"}
  description={"Add Traverse capabilities to your React app. Connect to the traverse-cli serve HTTP/JSON API, submit governed requests, and display trace output."}
  canonical={"https://traverse-framework.com/docs/guides/react-integration.html"}
  crumbs={[{ label: "Home", href: "/" }, { label: "Docs", href: "/docs.html" }]}
>
  <style is:global slot="head">.step-marker { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
    .step-circle { width: 28px; height: 28px; border-radius: 50%; background: var(--accent-dim); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); flex-shrink: 0; }
    .step-label { font-size: 0.72rem; color: var(--fg-muted); font-family: var(--font-mono); letter-spacing: 0.05em; text-transform: uppercase; }
    .doc-step { padding: 2.5rem 0; border-bottom: 1px solid var(--border); }
    .doc-step:last-child { border-bottom: none; }
    .info-box { background: color-mix(in srgb, var(--accent) 6%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent); border-radius: 8px; padding: 1rem 1.25rem; margin: 1.25rem 0; font-size: 0.875rem; color: var(--fg-muted); line-height: 1.6; }
    .info-box strong { color: var(--fg); }
    .success-box { background: color-mix(in srgb, var(--success) 6%, transparent); border: 1px solid color-mix(in srgb, var(--success) 20%, transparent); border-radius: 8px; padding: 1rem 1.25rem; margin: 1.25rem 0; font-size: 0.875rem; color: var(--fg-muted); line-height: 1.6; }
    .success-box strong { color: var(--success); }
    .response-field { display: flex; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--border); align-items: flex-start; }
    .response-field:last-child { border-bottom: none; }
    .rf-key { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent); width: 150px; flex-shrink: 0; }
    .rf-desc { font-size: 0.85rem; color: var(--fg-muted); line-height: 1.5; }
    .arch-diagram { background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; margin: 1.25rem 0; font-family: var(--font-mono); font-size: 0.8rem; line-height: 2.2; }
    .arch-box { display: inline-block; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 5px; padding: 0.2rem 0.65rem; color: var(--fg); }
    .arch-box.accent { border-color: color-mix(in srgb, var(--accent) 40%, transparent); color: var(--accent); }
    .arch-arrow { color: var(--fg-muted); margin: 0 0.5rem; }</style>
  <Fragment set:html={_body} />
</SubpageLayout>
